# Botトークンはここへ書かないでください。macOSキーチェーンから取得します。
DISCORD_GUILD_IDS=サーバーID1,サーバーID2
MONITOR_ALL_GUILDS=true
MONITORED_CHANNEL_IDS=
ALERT_CHANNEL_IDS=
MODERATION_BACKEND=groq
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VOICE_TEXT_MODEL=openai/gpt-oss-safeguard-20b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GROQ_FALLBACK_SPEECH_MODEL=whisper-large-v3
GROQ_CONFIDENCE_THRESHOLD=25
GROQ_TIMEOUT_SECONDS=20
GROQ_TEXT_INTERVAL_SECONDS=10
GROQ_VOICE_INTERVAL_SECONDS=10
GROQ_AUDIO_INTERVAL_SECONDS=6
VOICE_ENABLED=true
VOICE_AUTO_JOIN=true
VOICE_CHANNEL_IDS=
VOICE_ALERT_CHANNEL_IDS=
VOICE_CHUNK_SECONDS=10
VOICE_MIN_RMS=25
VOICE_MIN_UTTERANCE_MS=100
